#!/bin/bash
# 公開リポジトリの pre-push。push するコミットについて次を確かめる。
#   - gitleaks で秘密が無いこと
#   - author・committer が GitHub の noreply アドレスであること（実名のメールを公開しない）
#   - push する HEAD の判断レビューの記録（.git/publish-review/<sha>、中身あり）があること。
#     記録は、差分を読んで会社・個人・非公開の情報が無いと判断したときに書く（手順は CLAUDE.md）。
#     人が自分で確かめて push するときは PUBLISH_REVIEWED=1 で記録を省ける（作者の検査は省けない）
cd "$(git rev-parse --show-toplevel)" || exit 1
fail() { printf 'pre-push: %b\n' "$1" >&2; exit 1; }
command -v gitleaks >/dev/null || fail "gitleaks が無い（brew install gitleaks）"
gitdir=$(git rev-parse --git-dir)
z=0000000000000000000000000000000000000000
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  gitleaks git --log-opts="$range" --no-banner --redact -l warn >/dev/null 2>&1 || fail "gitleaks が検出した（$range）"
  bad=$(git log --format='%h %ae %ce' "$range" | awk '$2 !~ /@users\.noreply\.github\.com$/ || $3 !~ /@users\.noreply\.github\.com$/')
  [ -z "$bad" ] || fail "author か committer が noreply アドレスでないコミットがある:\n$bad"
  if [ -z "${PUBLISH_REVIEWED:-}" ] && [ ! -s "$gitdir/publish-review/$lsha" ]; then
    fail "$lsha の公開前レビューの記録が無い（手順は CLAUDE.md の「公開前レビュー」）。自分で確かめたなら PUBLISH_REVIEWED=1 を付けて push する"
  fi
done
exit 0
